# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.gradle text eol=lf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Declare files that will always have LF line endings on checkout (crucial for macOS gradlew)
gradlew text eol=lf
*.sh text eol=lf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.jar binary
*.so binary
